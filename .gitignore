# Whitelist: only what is meant to be public. Everything else (SOF/Linux checkouts, traces, logs, recordings, private notes) stays local.
/*
!/.gitignore
!/LICENSE
!/README.md
!/ohmydsp/
!/tools/
!/docs/
build/
__pycache__/
.DS_Store
*.wav
*.raw
*.bin
*.ri
*.ipc
!ohmydsp/data/dmic-p10.ipc
# private helpers
/tools/remove-old-dmicprobe.sh

# Generated topology and mailbox reports from the RPL bring-up.
/docs/rpl-ipc4-plan.json
/docs/rpl-ipc4-messages.json
/docs/rpl-ipc4-messages-live.json
